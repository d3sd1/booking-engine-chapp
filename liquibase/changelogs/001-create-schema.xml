<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!-- ==================== -->
    <!-- Customer table (DDL) -->
    <!-- ==================== -->
    <changeSet id="001-01" author="andrei.garcia">
        <comment>Create customer table for guest contact information</comment>
        <createTable tableName="pms_customer">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(254)">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- ===================== -->
    <!-- Room type table (DDL) -->
    <!-- ===================== -->
    <changeSet id="001-02" author="andrei.garcia">
        <comment>Create room_type table with pricing and capacity</comment>
        <createTable tableName="pms_room_type">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="max_guests" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- ================ -->
    <!-- Room table (DDL) -->
    <!-- ================ -->
    <changeSet id="001-03" author="andrei.garcia">
        <comment>Create room table linked to room_type</comment>
        <createTable tableName="pms_room">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="room_type_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="pms_room"
            baseColumnNames="room_type_id"
            constraintName="fk_room_room_type"
            referencedTableName="pms_room_type"
            referencedColumnNames="id"
            onDelete="SET NULL"/>
    </changeSet>

    <!-- =================== -->
    <!-- Booking table (DDL) -->
    <!-- =================== -->
    <changeSet id="001-04" author="andrei.garcia">
        <comment>Create booking table with state machine (NEW/DEL)</comment>
        <createTable tableName="pms_booking">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="state" type="VARCHAR(3)" defaultValue="NEW">
                <constraints nullable="false"/>
            </column>
            <column name="checkin" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="checkout" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="room_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="guests" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="customer_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="total" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(8)">
                <constraints nullable="false"/>
            </column>
            <column name="created" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="pms_booking"
            baseColumnNames="room_id"
            constraintName="fk_booking_room"
            referencedTableName="pms_room"
            referencedColumnNames="id"
            onDelete="SET NULL"/>
        <addForeignKeyConstraint
            baseTableName="pms_booking"
            baseColumnNames="customer_id"
            constraintName="fk_booking_customer"
            referencedTableName="pms_customer"
            referencedColumnNames="id"
            onDelete="SET NULL"/>
    </changeSet>

</databaseChangeLog>
