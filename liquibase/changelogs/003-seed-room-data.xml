<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!-- ========================================= -->
    <!-- DML: Room types (runs in ALL environments) -->
    <!-- ========================================= -->
    <changeSet id="003-01" author="andrei.garcia">
        <comment>Seed room types: 4 types as per business spec</comment>
        <insert tableName="pms_room_type">
            <column name="id" valueNumeric="1"/>
            <column name="name" value="Individual"/>
            <column name="price" valueNumeric="20"/>
            <column name="max_guests" valueNumeric="1"/>
        </insert>
        <insert tableName="pms_room_type">
            <column name="id" valueNumeric="2"/>
            <column name="name" value="Doble"/>
            <column name="price" valueNumeric="30"/>
            <column name="max_guests" valueNumeric="2"/>
        </insert>
        <insert tableName="pms_room_type">
            <column name="id" valueNumeric="3"/>
            <column name="name" value="Triple"/>
            <column name="price" valueNumeric="40"/>
            <column name="max_guests" valueNumeric="3"/>
        </insert>
        <insert tableName="pms_room_type">
            <column name="id" valueNumeric="4"/>
            <column name="name" value="Cuádruple"/>
            <column name="price" valueNumeric="50"/>
            <column name="max_guests" valueNumeric="4"/>
        </insert>
    </changeSet>

    <!-- ===================================================== -->
    <!-- DML: Rooms (10 individual, 5 double, 4 triple, 6 quad) -->
