<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!-- ================================================================= -->
    <!-- DML: Mock data — ONLY runs in 'local' and 'preprod' contexts      -->
    <!-- Usage: liquibase --contexts=local update                          -->
    <!--        liquibase --contexts=preprod update                        -->
    <!-- Production and staging skip this changeset entirely               -->
    <!-- ================================================================= -->

    <!-- Mock customers -->
    <changeSet id="004-01" author="andrei.garcia" context="local,preprod">
        <comment>Mock customers for local development and preprod testing</comment>
        <insert tableName="pms_customer">
            <column name="id" valueNumeric="1"/>
            <column name="name" value="María García López"/>
            <column name="email" value="maria.garcia@example.com"/>
            <column name="phone" value="+34 612 345 678"/>
        </insert>
        <insert tableName="pms_customer">
            <column name="id" valueNumeric="2"/>
            <column name="name" value="John Smith"/>
            <column name="email" value="john.smith@example.com"/>
            <column name="phone" value="+44 7911 123456"/>
        </insert>
        <insert tableName="pms_customer">
            <column name="id" valueNumeric="3"/>
            <column name="name" value="Hans Müller"/>
            <column name="email" value="hans.mueller@example.com"/>
            <column name="phone" value="+49 151 12345678"/>
        </insert>
        <insert tableName="pms_customer">
            <column name="id" valueNumeric="4"/>
            <column name="name" value="Sophie Dupont"/>
            <column name="email" value="sophie.dupont@example.com"/>
            <column name="phone" value="+33 6 12 34 56 78"/>
        </insert>
    </changeSet>

    <!-- Mock bookings: active reservations -->
    <changeSet id="004-02" author="andrei.garcia" context="local,preprod">
        <comment>Mock bookings: mix of confirmed and cancelled for realistic testing</comment>

        <!-- Confirmed bookings -->
        <insert tableName="pms_booking">
            <column name="state" value="NEW"/>
            <column name="checkin" valueDate="2026-04-01"/>
            <column name="checkout" valueDate="2026-04-05"/>
            <column name="room_id" valueNumeric="1"/>
            <column name="guests" valueNumeric="1"/>
            <column name="customer_id" valueNumeric="1"/>
            <column name="total" valueNumeric="80"/>
            <column name="code" value="MOCK0001"/>
        </insert>
        <insert tableName="pms_booking">
            <column name="state" value="NEW"/>
            <column name="checkin" valueDate="2026-04-02"/>
            <column name="checkout" valueDate="2026-04-06"/>
            <column name="room_id" valueNumeric="11"/>
            <column name="guests" valueNumeric="2"/>
            <column name="customer_id" valueNumeric="2"/>
            <column name="total" valueNumeric="120"/>
            <column name="code" value="MOCK0002"/>
        </insert>
        <insert tableName="pms_booking">
            <column name="state" value="NEW"/>
            <column name="checkin" valueDate="2026-04-10"/>
            <column name="checkout" valueDate="2026-04-15"/>
            <column name="room_id" valueNumeric="16"/>
            <column name="guests" valueNumeric="3"/>
            <column name="customer_id" valueNumeric="3"/>
            <column name="total" valueNumeric="200"/>
            <column name="code" value="MOCK0003"/>
        </insert>
        <insert tableName="pms_booking">
            <column name="state" value="NEW"/>
            <column name="checkin" valueDate="2026-04-20"/>
            <column name="checkout" valueDate="2026-04-25"/>
            <column name="room_id" valueNumeric="20"/>
            <column name="guests" valueNumeric="4"/>
            <column name="customer_id" valueNumeric="4"/>
            <column name="total" valueNumeric="250"/>
            <column name="code" value="MOCK0004"/>
        </insert>

        <!-- Cancelled booking for testing filters -->
        <insert tableName="pms_booking">
            <column name="state" value="DEL"/>
            <column name="checkin" valueDate="2026-03-15"/>
            <column name="checkout" valueDate="2026-03-18"/>
            <column name="room_id" valueNumeric="2"/>
            <column name="guests" valueNumeric="1"/>
            <column name="customer_id" valueNumeric="1"/>
            <column name="total" valueNumeric="60"/>
            <column name="code" value="MOCK0005"/>
        </insert>

        <!-- Overlapping booking for availability conflict testing -->
        <insert tableName="pms_booking">
            <column name="state" value="NEW"/>
            <column name="checkin" valueDate="2026-04-03"/>
            <column name="checkout" valueDate="2026-04-07"/>
            <column name="room_id" valueNumeric="1"/>
            <column name="guests" valueNumeric="1"/>
            <column name="customer_id" valueNumeric="2"/>
            <column name="total" valueNumeric="80"/>
            <column name="code" value="MOCK0006"/>
        </insert>
    </changeSet>

</databaseChangeLog>
